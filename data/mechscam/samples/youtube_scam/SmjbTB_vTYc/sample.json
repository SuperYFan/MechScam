_id": "DESCRIPTION_0001", "kind": "DESCRIPTION", "text": "Those who want to join Forsage, please message me immediately on Facebook, Instagram, and Telegram. My Facebook ...", "location": {"field": "description", "char_start": 0, "char_end": 115, "offset_basis": "whitespace_normalized"}}, {"source_id": "ASR_0001", "kind": "ASR", "text": "I invite the youth of my country on this vacation. There is a plan for referral. If you will explain to someone about the app, explain to a merchant, explain it to a citizen, they will download their mobile app.", "location": {"field": "full_text", "char_start": 0, "char_end": 211, "offset_basis": "whitespace_normalized"}}], "label_evidence": [{"source_id": "TITLE_0001", "kind": "TITLE", "text": "Forsage big referral income #PM modi #Referral #Forsage #blockchain", "location": {"field": "title", "char_start": 0, "char_end": 67, "offset_basis": "whitespace_normalized"}}, {"source_id": "DESCRIPTION_0001", "kind": "DESCRIPTION", "text": "Those who want to join Forsage, please message me immediately on Facebook, Instagram, and Telegram. My Facebook ...", "location": {"field": "description", "char_start": 0, "char_end": 115, "offset_basis": "whitespace_normalized"}}, {"source_id": "ASR_0001", "kind": "ASR", "text": "I invite the youth of my country on this vacation. There is a plan for referral. If you will explain to someone about the app, explain to a merchant, explain it to a citizen, they will download their mobile app.", "location": {"field": "full_text", "char_start": 0, "char_end": 211, "offset_basis": "whitespace_normalized"}}]}, "potential_elements": {"textual": [{"element_id": "T001", "observation": "The source presents Forsage as offering 'big referral income' while asking viewers to join, contact the speaker immediately, and encourage other people to download the app.", "dimensions": ["reward_or_return_claim", "requested_action", "conditions_or_urgency"], "evidence": [{"source_id": "TITLE_0001", "quote": "Forsage big referral income #PM modi #Referral #Forsage #blockchain"}, {"source_id": "DESCRIPTION_0001", "quote": "Those who want to join Forsage, please message me immediately on Facebook, Instagram, and Telegram."}, {"source_id": "ASR_0001", "quote": "There is a plan for referral. If you will explain to someone about the app, explain to a merchant, explain it to a citizen, they will download their mobile app."}], "context": "The records use promotional and recruitment language. Whether the referral income is guaranteed, whether the speaker is affiliated with Forsage, and whether the statements are endorsed or merely repeated are unclear.", "potential_relevance": "The stated income benefit is linked to joining, immediate outreach through multiple messaging platforms, and recruiting others to download the app, creating a reward-for-recruitment relationship for later context assessment.", "limitations": "No income amount, payment or transfer step, recipient of funds, app destination, identity verification, or evidence of actual downloads or earnings is provided. The '#PM modi' text is only shown as a hashtag and does not establish endorsement."}], "visual": [], "textual_context_notes": [{"observation": "The ASR explicitly frames the content as an invitation to youth and describes a referral plan.", "evidence": [{"source_id": "ASR_0001", "quote": "I invite the youth of my country on this vacation. There is a plan for referral."}]}], "visual_context_notes": []}, "annotation": {"binary_label": "Scam", "primary_subtype": "S06", "content_role": "promotion_or_instruction", "contextual_rationale": "This video is scam content because it presents Forsage as a source of \"big referral income\" and invites viewers to join and contact the speaker immediately. The speech describes recruiting people to download the app through the referral plan, connecting the financial benefit with participation and recruitment. The records do not establish an income amount, payment step, app destination, actual earnings, or the speaker's affiliation with Forsage.", "fine_grained_rationale": "The primary mechanism is recruitment-linked referral income: the title promotes 'big referral income', while the speech describes a referral plan based on explaining the app to other people so they download it. This supports S06 as the best-grounded recruitment subtype, although the records do not specify downline levels, tiers, matrices, or commission amounts.", "evidence": [{"evidence_id": "E001", "observation": "The title associates Forsage with referral income and describes the income as big.", "source_id": "TITLE_0001", "quote": "Forsage big referral income"}, {"evidence_id": "E002", "observation": "The description invites people who want to join Forsage to contact the speaker immediately.", "source_id": "DESCRIPTION_0001", "quote": "Those who want to join Forsage, please message me immediately"}, {"evidence_id": "E003", "observation": "The speech explicitly describes a referral plan.", "source_id": "ASR_0001", "quote": "There is a plan for referral."}, {"evidence_id": "E004", "observation": "The speech links explaining the app to other people with those people downloading the mobile app.", "source_id": "ASR_0001", "quote": "If you will explain to someone about the app, explain to a merchant, explain it to a citizen, they will download their mobile app."}, {"evidence_id": "E005", "observation": "The speaker frames the message as an invitation to the country's youth.", "source_id": "ASR_0001", "quote": "I invite the youth of my country on this vacation."}]}}
